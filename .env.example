# Settings for the AI summary. Copy this file to .env, then replace <YOUR_API_KEY> with your key:
#   cp .env.example .env
# .env is gitignored, so your key stays on your machine. This file is public: never put a real key here.
# A missing or wrong setting doesn't stop the checker: code writes the summaries and says what to fix.

# Your Gemini API key, from https://aistudio.google.com/apikey. Empty turns the AI off.
GEMINI_API_KEY=<YOUR_API_KEY>

# The model that writes the summaries. Required with a key.
# Rewording numbers that code already computed doesn't need a big model. Timed on the same
# request (Nov 2026): gemini-3.5-flash-lite 1.8 s with minimal thinking, gemini-3.8-flash 113 s.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: how much the model thinks before answering: minimal, low, medium or high.
# Empty means the model's own default. Not every model supports every level.
GEMINI_THINKING_LEVEL=minimal
